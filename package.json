{
  "name": "ai-title-siyuan",
  "version": "1.1.0",
  "description": "Generate note titles with the Chat Completions, Responses, Anthropic Messages or Gemini Interactions API",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/build-package.mjs",
    "icon": "node scripts/render-icon.mjs && node scripts/render-preview.mjs",
    "preview": "node scripts/render-preview.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "ai",
    "title",
    "openai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "archiver": "^7.0.1",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.104.1",
    "sharp": "^0.35.4",
    "siyuan": "^1.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.2"
  }
}
